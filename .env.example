# Copy to .env.local and fill in.

# ─── Firebase (public web config) ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server-only secret) ───────────────────────────────────────
# Local dev: path to the service-account JSON file (gitignored).
FIREBASE_ADMIN_CREDENTIALS_FILE=
# Deploys: single-line service-account JSON.
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# ─── Ledger (pure-Excel live store) ────────────────────────────────────────────
LEDGER_XLSX_PATH=./data/capsule-ledger.xlsx
LEDGER_XLSX_PASSWORD=change-me
LEDGER_BACKUP_COUNT=10

# ─── Economy: mining ───────────────────────────────────────────────────────────
MINING_COOLDOWN_HOURS=8
MINING_BASE_REWARD=50
MINING_HALVING_SUPPLY=5000
MINING_MIN_REWARD=2

# ─── Economy: coin value ───────────────────────────────────────────────────────
VALUE_K=100
VALUE_WINDOW_DAYS=7
CC_BDT_MIN=0.5
CC_BDT_MAX=10
CC_SPREAD_SCALE=180
USD_BDT_RATE=120

# ─── Economy: balance floor (members may go negative down to here) ──────────────
BALANCE_FLOOR=-500

# ─── DesertHouse (Google Chat) auto-trade integration ───────────────────────────
# Static token the Workspace Studio Flow presents when POSTing a detected trade to
# /api/desert-house/trade. Studio's "Send a webhook" step has no custom headers, so
# put this in the JSON payload as {"token":"<value>"} (an Authorization: Bearer
# <token> header is also accepted, e.g. for curl). Generate a long random value.
# Leave blank to disable the integration (the endpoint returns 503).
DESERT_HOUSE_TOKEN=
# Reject parsed amounts above this — a guard against mis-parsed free text. Default 1000.
DESERT_HOUSE_MAX_CC=1000
