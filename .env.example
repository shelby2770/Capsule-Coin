# Copy to .env.local and fill in.

# ─── Firebase (public web config) ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server-only secret) ───────────────────────────────────────
# Local dev: path to the service-account JSON file (gitignored).
FIREBASE_ADMIN_CREDENTIALS_FILE=
# Deploys: single-line service-account JSON.
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# ─── Ledger (pure-Excel live store) ────────────────────────────────────────────
LEDGER_XLSX_PATH=./data/capsule-ledger.xlsx
LEDGER_XLSX_PASSWORD=change-me
LEDGER_BACKUP_COUNT=10

# ─── Economy: mining ───────────────────────────────────────────────────────────
MINING_COOLDOWN_HOURS=8
MINING_BASE_REWARD=50
MINING_HALVING_SUPPLY=5000
MINING_MIN_REWARD=2

# ─── Economy: coin value ───────────────────────────────────────────────────────
VALUE_K=100
VALUE_WINDOW_DAYS=7
CC_BDT_MIN=0.5
CC_BDT_MAX=10
CC_SPREAD_SCALE=180
USD_BDT_RATE=120

# ─── Economy: balance floor (members may go negative down to here) ──────────────
BALANCE_FLOOR=-500

# ─── DesertHouse (Google Chat) auto-trade integration ───────────────────────────
# Static token the Workspace Studio Flow presents when POSTing a detected trade to
# /api/desert-house/trade. Studio's "Send a webhook" step has no custom headers, so
# put this in the JSON payload as {"token":"<value>"} (an Authorization: Bearer
# <token> header is also accepted, e.g. for curl). Generate a long random value.
# Leave blank to disable the integration (the endpoint returns 503).
DESERT_HOUSE_TOKEN=
# Reject parsed amounts above this — a guard against mis-parsed free text. Default 1000.
DESERT_HOUSE_MAX_CC=1000
# Same guard for real-money DC purchases reported in chat (taka). Buy tiers top out
# at ৳1000; allow headroom, reject clearly mis-parsed amounts. Default 5000.
DESERT_HOUSE_MAX_BDT=5000

# ─── Economy: credit-floor grace / ban ─────────────────────────────────────────
# BALANCE_FLOOR above is the SOFT trigger: cross below it and a graceDays countdown
# starts; recover to >= it in time or be permanently banned. hardFloor is the
# absolute stop a single spend can never breach.
CC_HARD_FLOOR=-1000
CC_GRACE_DAYS=3

# ─── Economy: Dark Capsule Coin (DC) ────────────────────────────────────────────
# Mining mints DC (paid mining still burns CC). DC converts to CC and is spent on
# non-food DesertHouse trades. DC->CC rate: CC = x * b(x) * m(S), fitted to the
# 2/10/20 example. Anchor DC_REF_SUPPLY (S0) to the post-migration total DC —
# scripts/migrate-mining-to-dc.cjs prints it (dry-run showed ~906).
DC_REF_SUPPLY=906
DC_SUPPLY_GAMMA=0.4
DC_CLAMP_MIN=0.5
DC_CLAMP_MAX=1.5
# DC->CC per-DC "bulk" curve:
#   b(x) = DC_BULK_FLOOR + DC_BULK_LOG_GAIN*ln(x) + DC_BULK_TAIL_GAIN*x^DC_BULK_TAIL_POW
#          (clamped to DC_BULK_RATE_MAX)
# A low floor for small conversions, a gentle log rise through the middle, and an
# accelerating tail so LARGE conversions keep earning more. Fitted to 1->0.3, 10->0.4,
# 100->0.5, 500->0.7, 1000->1.0, 1500->1.5, 2000->2.0 (base, before the supply ×N
# multiplier). Set DC_BULK_LOG_GAIN and DC_BULK_TAIL_GAIN to 0 to flatten to a constant.
DC_BULK_FLOOR=0.3
DC_BULK_LOG_GAIN=0.04
DC_BULK_TAIL_GAIN=0.0000054
DC_BULK_TAIL_POW=1.64
DC_BULK_RATE_MAX=3.0
DC_MIN_CONVERT=1
# Buy DC with real money (admin-recorded). Rate set later; proceeds -> Capsule Fruit Fund.
DC_BDT_PER_DC=0
# Buying DC with taka: a stable, generous real-money on-ramp. ৳100 -> DC_BUY_PER_100
# DC (the anchor, decoupled from the volatile CC spread). Bigger buys earn a bounded
# volume bonus on top (up to +DC_BUY_BONUS_MAX; DC_BUY_BONUS_SCALE (৳) ramps it in).
DC_BUY_PER_100=113
DC_BUY_BONUS_MAX=0.5
DC_BUY_BONUS_SCALE=500
FRUIT_MINISTER_EMAIL=jakir.hossen@orbitax.com

# ─── Arcade: earn DC through mini-games (word guessing, type racing) ─────────────
# Wins mint DC (tx type GAME) against the SAME fixed mining reserve
# (MINING_SUPPLY_CAP), so total DC inflation stays bounded. A paid entry burns CC.
# One free play per UTC day, SHARED across mining + all games (replaces the old
# per-day mining free allowance — a free member picks ONE activity per day).
GAMES_FREE_PLAYS_PER_DAY=1
# Pay-to-play ladder: burn CC to play ONE game at tier 1/2/3 (mirrors mining).
GAMES_TIER1_FEE=20
GAMES_TIER2_FEE=50
GAMES_TIER3_FEE=100
# Guess-the-word: words per tier [free,1,2,3]. Reward by guess count: 1st guess =
# BASE_REWARD, 2nd = SECOND_CHANCE_REWARD, then halves each extra guess (3rd, 4th …),
# all × a time factor (slower than SEC_PER_ATTEMPT×guesses scales down, floored at
# FLOOR) × the per-tier multiplier below.
GAMES_WORD_COUNT_FREE=1
GAMES_WORD_COUNT_T1=3
GAMES_WORD_COUNT_T2=5
GAMES_WORD_COUNT_T3=10
GAMES_WORD_MAX_ATTEMPTS=7
GAMES_WORD_BASE_REWARD=100
GAMES_WORD_SECOND_CHANCE_REWARD=10
GAMES_WORD_SEC_PER_ATTEMPT=30
GAMES_WORD_TIME_FLOOR=0.1
# Per-tier reward multiplier [free, t1, t2, t3] applied on top of the base reward.
# Left at 1 across the board (paid tiers already pay more via extra words).
GAMES_WORD_MULT_FREE=1
GAMES_WORD_MULT_T1=1
GAMES_WORD_MULT_T2=1
GAMES_WORD_MULT_T3=1
# A word session self-ends after this many seconds, PER TIER [free,1,2,3] (the
# on-screen clock keeps running across leave/return; DC earned so far is finalized
# at the tier's cap). Higher tiers get more time for their extra words.
GAMES_WORD_TTL_FREE=180
GAMES_WORD_TTL_T1=300
GAMES_WORD_TTL_T2=600
GAMES_WORD_TTL_T3=1200
# Days a copy/screenshot-cheat ban locks Guess the Word (this game only, not the account).
GAMES_WORD_BAN_DAYS=3
# Type racing: reward = base at BASE_WPM, halving each STEP_WPM below it, continuously
# down toward 0 WPM (no floor); MAX_WPM is an anti-cheat ceiling. Paragraph difficulty
# per tier [free,1,2,3] maps to pool docs d1..d5 (higher = harder; free gets the hardest).
GAMES_TYPE_BASE_REWARD=100
GAMES_TYPE_BASE_WPM=100
GAMES_TYPE_STEP_WPM=10
GAMES_TYPE_MAX_WPM=220
GAMES_TYPE_DIFF_FREE=5
GAMES_TYPE_DIFF_T1=4
GAMES_TYPE_DIFF_T2=3
GAMES_TYPE_DIFF_T3=2
# Free re-attempts per paid entry [free,1,2,3]: retry (fresh paragraph, no charge)
# to beat your best — usable to restart mid-race or after finishing. Only an
# improved best mints more DC (top-up).
GAMES_TYPE_REATTEMPTS_FREE=0
GAMES_TYPE_REATTEMPTS_T1=1
GAMES_TYPE_REATTEMPTS_T2=2
GAMES_TYPE_REATTEMPTS_T3=3
# "Get ready" breather (seconds): the passage is shown but the clock only starts
# after this, so reading/settling isn't timed.
GAMES_TYPE_COUNTDOWN_SEC=5
# Paid-tier reward multipliers [free,1,2,3] on the WPM reward — paid entries pay
# proportionally more (the WPM cap limits the base, so this is the profit lever).
GAMES_TYPE_MULT_FREE=1
GAMES_TYPE_MULT_T1=3
GAMES_TYPE_MULT_T2=7
GAMES_TYPE_MULT_T3=10

# ─── OpenRouter (LLM backend for Problem Solving + optional AI Blitz gen) ────────
# Your OWN OpenRouter key. When blank, Problem Solving grading (and live MCQ
# generation) return a clear "not configured" error instead of calling out.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://capsule-coin.vercel.app
OPENROUTER_TIMEOUT_MS=30000

# ─── Arcade: Problem Solving (LeetCode-style, LLM-graded) ────────────────────────
# One problem per play, 5 min on a server clock (auto-submits at zero). The grader
# returns a mark 0–10; DC = (mark/10) × the tier cap. Free + Tier 1 only for now
# (Tier 2 topic-select + Tier 3 come later). Copy-guard: cumulatively copying
# COPY_RATIO of the statement bans this game (only) for BAN_DAYS days.
GAMES_PROBLEM_SEC=300
# Hard ceiling (ms) on AI grading at submit. If grading exceeds this or the grader
# errors, the entry is REFUNDED (CC back for a paid tier; the free play returned for
# the free tier), the problem goes back to the pool, and no DC is minted. Keep it >=
# OPENROUTER_TIMEOUT_MS so the HTTP client's own abort usually fires first.
GAMES_PROBLEM_GRADE_TIMEOUT_MS=40000
GAMES_PROBLEM_MAXDC_FREE=10
GAMES_PROBLEM_MAXDC_T1=50
GAMES_PROBLEM_COPY_RATIO=0.8
GAMES_PROBLEM_BAN_DAYS=3
# The free tier draws from its own curated bucket (problemPool/<this key>); paid
# tiers draw from the per-topic vault. Keep it out of the paid topic list.
GAMES_PROBLEM_FREE_KEY=free

# ─── Arcade: AI Blitz (rapid-fire AI/ML MCQ) ─────────────────────────────────────
# COUNT questions, SEC seconds each, 1 mark apiece, free tier only. DC = correct ×
# DC_PER_CORRECT (max = COUNT × DC_PER_CORRECT). LIVEGEN=true generates fresh
# questions via OpenRouter instead of drawing from the seeded pool (off by default).
GAMES_BLITZ_COUNT=5
GAMES_BLITZ_SEC=30
GAMES_BLITZ_DC_PER_CORRECT=1
GAMES_BLITZ_LIVEGEN=false
# Days a copy/screenshot-cheat ban locks AI Blitz (this game only, not the account).
GAMES_BLITZ_BAN_DAYS=3

# Marketplace offers auto-expire + are deleted once OPEN longer than this (ms). 2 days.
OFFER_TTL_MS=172800000

# ─── Mining keyspace retune (paid tiers — env wins over code defaults) ───────────
MINING_KEYSPACE_TIER1=995000000
MINING_KEYSPACE_TIER2=798000000
MINING_KEYSPACE_TIER3=798000000
# DC mining reserve (max NET DC ever mineable). Taper step keeps ~10 free-reward
# brackets across it (supplyCap / step).
MINING_SUPPLY_CAP=5000
MINING_REWARD_TAPER_STEP=500
MINING_MATCH_MAX=0.7
